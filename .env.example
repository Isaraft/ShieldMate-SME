# Local development only. Copy to .env at the repository root.
# Account passwords are supplied through the UI, never environment files.
SHIELDMATE_ENVIRONMENT=development
# Relative SQLite paths are resolved from backend/ by both the API and Alembic.
SHIELDMATE_DATABASE_URL=sqlite:///./storage/shieldmate.db
# JSON arrays, not comma-separated strings. Never use a wildcard.
SHIELDMATE_ALLOWED_HOSTS=["localhost","127.0.0.1","backend"]
# Vite proxies /api on the same origin; cross-origin access is off by default.
SHIELDMATE_CORS_ORIGINS=[]
# Local HTTP only. Production rejects this setting; HTTPS requires true.
SHIELDMATE_COOKIE_SECURE=false
SHIELDMATE_TRUSTED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
SHIELDMATE_SESSION_SECONDS=28800
# Per-IP and per-normalized-account attempts in a 15-minute window (single worker).
SHIELDMATE_AUTH_RATE_LIMIT=10
# Domain ownership: exact DNS TXT proof; scanners require fresh proof and consent.
SHIELDMATE_DOMAIN_QUOTA=5
SHIELDMATE_CHALLENGE_SECONDS=172800
SHIELDMATE_VERIFICATION_SECONDS=2592000
SHIELDMATE_DNS_TIMEOUT=3.0
# Persisted per-organization audit-event budget over 15 minutes.
SHIELDMATE_DOMAIN_RATE_LIMIT=20
# Per-process connection-IP budget (Nginx shares an aggregate proxy IP locally).
SHIELDMATE_DOMAIN_IP_RATE_LIMIT=100

# Persisted rolling hourly scan quotas. One active scan/domain; one global worker slot.
SHIELDMATE_SCAN_USER_HOURLY=6
SHIELDMATE_SCAN_ORG_HOURLY=6
SHIELDMATE_SCAN_DOMAIN_HOURLY=2
SHIELDMATE_SCAN_QUEUE_LIMIT=20
# Retain at most 100 runs/org; oldest terminal run >1h is removed when capacity is reached.
SHIELDMATE_SCAN_HISTORY_LIMIT=100
# Overall network budget; each DNS/connect/TLS/read operation is additionally bounded.
SHIELDMATE_SCAN_TIMEOUT=45.0
SHIELDMATE_SCAN_IO_TIMEOUT=3.0
# Fixed safety bounds: TCP80/443, 13 observations, 4KiB evidence/check, 16KiB headers,
# zero application body reads, no redirects/proxies, worker lease90s, queue expiry15m.
# Do not widen network scope through environment configuration.

# Finding evidence freshness annotation only; never auto-resolves an issue.
SHIELDMATE_FINDING_STALE_SECONDS=604800
