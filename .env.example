# Local development only. Copy to .env at the repository root.
# Account passwords are supplied through the UI, never environment files.
SHIELDMATE_ENVIRONMENT=development
# Relative SQLite paths are resolved from backend/ by both the API and Alembic.
SHIELDMATE_DATABASE_URL=sqlite:///./storage/shieldmate.db
# JSON arrays, not comma-separated strings. Never use a wildcard.
SHIELDMATE_ALLOWED_HOSTS=["localhost","127.0.0.1","backend"]
# Vite proxies /api on the same origin; cross-origin access is off by default.
SHIELDMATE_CORS_ORIGINS=[]
# Local HTTP only. Production rejects this setting; HTTPS requires true.
SHIELDMATE_COOKIE_SECURE=false
SHIELDMATE_TRUSTED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
SHIELDMATE_SESSION_SECONDS=28800
# Per-IP and per-normalized-account attempts in a 15-minute window (single worker).
SHIELDMATE_AUTH_RATE_LIMIT=10
