# Optional port for compose.local.yaml; bindings remain fixed to 127.0.0.1.
# docker compose --env-file .env.local -f compose.local.yaml up --build -d --wait
SHIELDMATE_RC_PORT=8080
# No signing secret: random opaque sessions and CSRF are hashed in the private SQLite DB.
# Local HTTP is an explicit local_release mode; HTTPS production requirements stay enforced.
